---
import { getEntry, type CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import ProjectDetail from '../components/ProjectDetail.astro';
import { loadProject } from '../lib/project';

// /projects/<이름>/ 과 /<직무>/projects/<이름>/ 이 공유하는 프로젝트 전체 페이지
interface Props {
  entry: CollectionEntry<'projects'>;
  // 직무 이름(backend 등). 있으면 그 직무용 본문을 보여 주고 그 직무 페이지로 돌아감
  track?: string;
}

const { entry, track } = Astro.props;
const project = await loadProject(entry, track);
const intro = (await getEntry('profile', 'intro'))!.data;
---

<Base title={`${project.name} · ${intro.name}의 포트폴리오`} description={project.summary} image={project.image ? `/og/${project.id}.jpg` : '/og/intro.png'}>
  <main class="container page">
    <nav class="back no-print" aria-label="이동">
      <a href={`${track ? `/${track}/` : '/'}#projects`}>← 포트폴리오로</a>
    </nav>
    <article>
      <ProjectDetail project={project} variant="page" track={track} />
    </article>
  </main>
</Base>

<style>
  .page {
    padding-block: var(--s-xl) var(--s-section);
  }
  .back {
    margin-bottom: var(--s-lg);
    font-size: var(--t-body-sm);
  }
  .back a {
    color: var(--c-muted);
    text-decoration: none;
  }
  .back a:hover {
    color: var(--c-ink);
  }
</style>
