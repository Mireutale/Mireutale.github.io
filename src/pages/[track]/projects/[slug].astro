---
import { getCollection } from 'astro:content';
import ProjectPage from '../../../layouts/ProjectPage.astro';

// /<직무>/projects/<이름>/ — 직무 페이지의 모달에서 "전체 페이지"로 넘어올 때
export async function getStaticPaths() {
  const tracks = await getCollection('tracks');
  const entries = await getCollection('projects');
  return tracks.flatMap((track) =>
    entries.map((entry) => ({ params: { track: track.id, slug: entry.id }, props: { entry } })),
  );
}

const { entry } = Astro.props;
---

<ProjectPage entry={entry} track={Astro.params.track} />
