---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Entries from '../components/Entries.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Awards from '../components/Awards.astro';
import { profile } from '../data/profile';
---

<Base title={`${profile.name}의 포트폴리오`} description={profile.tagline}>
  <Hero />
  <main>
    <Entries id="experience" title="경험" entries={[...profile.education, ...profile.experience].sort((a, b) => a.period.localeCompare(b.period))} />
    <Projects />
    <Awards />
    <Skills />
  </main>
</Base>
