---
import { profile } from '../data/profile';
---

<aside class="rail" aria-label="바로가기">
  <a class="chip chip-carbon rail-btn" href={`mailto:${profile.email}`}>✉ E-mail</a>
  <a class="chip chip-carbon rail-btn" href={profile.github} target="_blank" rel="noopener">▣ GitHub</a>
  <a class="chip chip-carbon rail-btn" href="#contact">? Contact</a>

  <section id="awards" class="info-box" aria-labelledby="awards-heading">
    <h2 id="awards-heading" class="tab label">Awards</h2>
    <ol class="awards">
      {
        profile.awards.map((a) => (
          <li>
            <span class="micro date">{a.date}</span>
            <span class="award-title">{a.title}</span>
            <span class="micro team">{a.team}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <div class="promo">
    <span class="boxart">Now Playing</span>
    <p>AI·SW 마에스트로 17기<br />팀 Fruition</p>
  </div>
</aside>

<style>
  .rail {
    display: grid;
    gap: var(--s-sm);
    align-content: start;
  }
  .rail-btn {
    justify-content: flex-start;
  }
  .info-box {
    border-radius: var(--r-sm);
    background: var(--c-surface);
    box-shadow: 0 0 0 1px var(--c-hairline);
    overflow: hidden;
  }
  .tab {
    padding: var(--s-xs) var(--s-sm);
    background: var(--c-amber);
    color: var(--c-carbon);
  }
  .awards {
    padding: var(--s-sm);
    list-style: none;
  }
  .awards li {
    display: grid;
    gap: 2px;
    padding: var(--s-xs) 0;
    border-bottom: 1px dotted var(--c-muted-indigo);
    word-break: keep-all;
  }
  .awards li:last-child {
    border-bottom: 0;
  }
  .date,
  .team {
    color: var(--c-ink-soft);
  }
  .award-title {
    font-weight: 700;
    color: var(--c-ink);
  }
  .promo {
    padding: var(--s-md);
    border-radius: var(--r-sm);
    background: var(--c-lavender);
    box-shadow: var(--bevel-plate);
  }
  .promo .boxart {
    font-size: 18px;
  }
  .promo p {
    margin-top: var(--s-sm);
    font-weight: 700;
  }
</style>
