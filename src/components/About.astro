---
import { profile } from '../data/profile';
---

<section id="about" class="section" aria-labelledby="about-heading">
  <div class="container grid">
    <div class="section-head">
      <p class="eyebrow">About Me</p>
      <h2 id="about-heading" class="section-title display">소개</h2>
    </div>
    <div class="text">
      {profile.about.map((p) => <p>{p}</p>)}
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: 260px 1fr;
    gap: var(--s-xl);
  }
  .section-head {
    margin-bottom: 0;
  }
  .text {
    display: grid;
    gap: var(--s-md);
    max-width: 40em;
    word-break: keep-all;
  }
  .text p:first-child {
    font-size: var(--t-title-md);
    font-weight: 600;
    color: var(--c-body-strong);
  }
  @media (max-width: 768px) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--s-lg);
    }
  }
</style>
