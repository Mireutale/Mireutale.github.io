---
import { EXPERIENCE_GROUPS } from '../lib/profile';

interface Block {
  summary: string;
  bullets: readonly string[];
}

interface Entry extends Block {
  group: string;
  org: string;
  url?: string;
  role: string;
  period?: string;
  sections?: readonly Block[];
}

interface Props {
  id: string;
  title: string;
  entries: readonly Entry[];
}

const { id, title, entries } = Astro.props;
const groups = EXPERIENCE_GROUPS.map((name) => ({ name, items: entries.filter((e) => e.group === name) })).filter(
  (g) => g.items.length > 0,
);

// "[text](url)" 조각을 링크로 렌더
const parts = (text: string) =>
  text.split(/(\[[^\]]+\]\([^)]+\))/).map((chunk) => {
    const m = chunk.match(/^\[([^\]]+)\]\(([^)]+)\)$/);
    return m ? { text: m[1], url: m[2] } : { text: chunk };
  });
// 사이트 안 링크(/…, #…)는 같은 탭, 바깥 링크는 새 탭
const external = (url: string) => /^https?:/.test(url);
---

<section id={id} class="section" aria-labelledby={`${id}-heading`}>
  <div class="container">
    <h2 id={`${id}-heading`} class="section-title display">{title}</h2>
    {
      groups.map((g, gi) => (
        <div class="group">
          {/* 첫 묶음은 섹션 제목과 같아서 소제목을 생략 */}
          {gi > 0 && <h3 class="group-title">{g.name}</h3>}
          <ol class="timeline">
            {g.items.map((e) => (
              <li class="item">
                {e.period && <p class="when">{e.period}</p>}
                <div class="body">
                  <h4 class="what">
                    {e.role} ·{' '}
                    {e.url ? (
                      <a href={e.url} target="_blank" rel="noopener">
                        {e.org} ↗
                      </a>
                    ) : (
                      e.org
                    )}
                  </h4>
                  {[e, ...(e.sections ?? [])].map((block, i) => (
                    <div class:list={['block', { later: i > 0 }]}>
                      {block.summary && (
                        <p class:list={['summary', { 'sub-title': i > 0 }]}>
                          {parts(block.summary).map((c) =>
                            c.url ? (
                              <a href={c.url} target={external(c.url) ? '_blank' : undefined} rel="noopener">
                                {c.text}
                              </a>
                            ) : (
                              c.text
                            ),
                          )}
                        </p>
                      )}
                      {block.bullets.length > 0 && (
                        <ul class="bullets">
                          {block.bullets.map((b) => (
                            <li>
                              {parts(b).map((c) =>
                                c.url ? (
                                  <a href={c.url} target={external(c.url) ? '_blank' : undefined} rel="noopener">
                                    {c.text}
                                  </a>
                                ) : (
                                  c.text
                                ),
                              )}
                            </li>
                          ))}
                        </ul>
                      )}
                    </div>
                  ))}
                </div>
              </li>
            ))}
          </ol>
        </div>
      ))
    }
    <slot />
  </div>
</section>

<style>
  .group + .group {
    margin-top: var(--s-xxl);
  }
  .group-title {
    margin-bottom: var(--s-sm);
    font-size: var(--t-caption-upper);
    font-weight: 600;
    letter-spacing: 1.5px;
    color: var(--c-muted);
  }
  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* 왼쪽 기간, 오른쪽 내용 */
  .item {
    display: grid;
    grid-template-columns: var(--col-side) minmax(0, 1fr);
    gap: var(--s-lg);
    padding-block: var(--s-lg);
    border-top: 1px solid var(--c-hairline);
  }
  /* 기간이 없어도 내용은 오른쪽(좁은 화면에서는 한 칸) 열에 */
  .body {
    grid-column: -2 / -1;
  }
  .when {
    padding-top: 3px;
    font-size: var(--t-caption);
    font-weight: 500;
    color: var(--c-muted);
    font-variant-numeric: tabular-nums;
  }
  .what {
    margin: 0 0 var(--s-xs);
    font-size: var(--t-title-md);
    font-weight: 600;
    color: var(--c-ink);
    word-break: keep-all;
  }
  .what a {
    color: inherit;
    text-decoration: none;
  }
  .what a:hover {
    color: var(--c-link);
  }
  .summary {
    max-width: 44em;
    word-break: keep-all;
  }
  .sub-title {
    font-weight: 600;
    color: var(--c-body-strong);
  }
  .later {
    margin-top: var(--s-sm);
  }
  .bullets {
    margin: var(--s-xs) 0 0;
    padding-left: 1.1em;
    list-style: disc;
    font-size: var(--t-body-sm);
  }
  .bullets li {
    margin-block: 2px;
    word-break: keep-all;
  }
  @media (max-width: 640px) {
    .item {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-xxs);
    }
  }
  @media print {
    .item {
      grid-template-columns: 130px 1fr;
      gap: 14px;
      padding-block: 10px;
      break-inside: avoid;
    }
  }
</style>
