---
interface Entry {
  org: string;
  url?: string;
  role: string;
  period: string;
  summary: string;
  bullets: readonly string[];
}

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  entries: readonly Entry[];
}

const { id, eyebrow, title, entries } = Astro.props;
---

<section id={id} class="section" aria-labelledby={`${id}-heading`}>
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">{eyebrow}</p>
      <h2 id={`${id}-heading`} class="section-title display">{title}</h2>
    </div>
    {
      entries.map((e) => (
        <article class="entry">
          <div class="entry-side">
            <h3>{e.org}</h3>
            {e.url && (
              <a href={e.url} target="_blank" rel="noopener">
                {e.url.replace(/^https?:\/\//, '')}
              </a>
            )}
            <p class="role">{e.role}</p>
            <p class="period">{e.period}</p>
          </div>
          <div class="entry-main">
            <p class="summary">{e.summary}</p>
            {e.bullets.length > 0 && (
              <ul>
                {e.bullets.map((b) => (
                  <li>{b}</li>
                ))}
              </ul>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>
