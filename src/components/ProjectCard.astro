---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

{
  project.featured ? (
    <article class="tile">
      <div class="tile-head">
        <span class="badge micro">{project.period}</span>
        <span class="badge micro">{project.type}</span>
      </div>
      <h3 class="boxart">{project.name}</h3>
      <p class="desc">{project.summary}</p>
      <ul class="stack" aria-label="기술 스택">
        {project.stack.map((s) => <li class="micro">{s}</li>)}
      </ul>
      <a class="chip chip-submit" href={project.repo} target="_blank" rel="noopener">View Repo ▸</a>
    </article>
  ) : (
    <article class="row">
      <div class="row-main">
        <a class="title" href={project.repo} target="_blank" rel="noopener">{project.name}</a>
        <p class="desc">{project.summary}</p>
        <ul class="stack" aria-label="기술 스택">
          {project.stack.map((s) => <li class="micro">{s}</li>)}
        </ul>
      </div>
      <div class="row-side">
        <span class="micro">{project.period}</span>
        <a class="arrow-chip" href={project.repo} target="_blank" rel="noopener" aria-label={`${project.name} 저장소`}>›</a>
      </div>
    </article>
  )
}

<style>
  .tile {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-md);
    padding: var(--s-lg);
    border-radius: var(--r-md);
    background-color: var(--c-systems-teal);
    background-image:
      linear-gradient(90deg, rgba(159, 190, 231, 0.18) 1px, transparent 1px),
      linear-gradient(0deg, rgba(159, 190, 231, 0.18) 1px, transparent 1px),
      radial-gradient(circle at 80% 20%, rgba(159, 190, 231, 0.35), transparent 45%);
    background-size: 16px 16px, 16px 16px, 100% 100%;
    color: var(--c-surface);
    box-shadow: var(--bevel-plate);
  }
  .tile-head {
    display: flex;
    gap: var(--s-xs);
  }
  .badge {
    padding: 2px 6px;
    border-radius: var(--r-xs);
    background: var(--c-amber);
    color: var(--c-carbon);
  }
  .tile h3 {
    font-size: clamp(26px, 4vw, 36px);
  }
  .tile .desc {
    color: var(--c-surface);
    font-weight: 700;
    max-width: 44em;
  }
  .tile .stack li {
    background: rgba(255, 255, 255, 0.9);
    color: var(--c-carbon);
  }
  .row {
    display: flex;
    gap: var(--s-sm);
    padding: var(--s-sm);
    border-radius: var(--r-sm);
    background: var(--c-platinum);
    box-shadow: inset 0 1px 0 #fff, 0 1px 0 var(--c-hairline);
  }
  .row:hover {
    background: var(--c-surface);
  }
  .row-main {
    flex: 1;
    min-width: 0;
  }
  .row-side {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-xs);
    color: var(--c-muted-indigo);
    white-space: nowrap;
  }
  .title {
    font-size: var(--t-link);
    text-transform: uppercase;
    letter-spacing: 0.3px;
  }
  .desc {
    margin-top: var(--s-xs);
    color: var(--c-ink);
    word-break: keep-all;
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-xs);
    margin-top: var(--s-sm);
    padding: 0;
    list-style: none;
  }
  .stack li {
    padding: 1px 5px;
    border-radius: var(--r-xs);
    background: var(--c-canvas-soft);
    color: var(--c-ink);
  }
</style>
