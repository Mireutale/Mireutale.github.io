---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  tone: 'pink' | 'teal' | 'lavender' | 'peach' | 'ochre' | 'cream';
}

const { project, tone } = Astro.props;
const isDark = tone === 'pink' || tone === 'teal';
---

<article class:list={['card', `tone-${tone}`, { dark: isDark, featured: project.featured }]}>
  <div class="meta">
    <span class="pill">{project.period}</span>
    <span class="pill">{project.type} 프로젝트</span>
  </div>
  <h3>{project.name}</h3>
  <p class="summary">{project.summary}</p>
  <ul class="stack" aria-label="기술 스택">
    {project.stack.map((s) => <li>{s}</li>)}
  </ul>
  <a class="btn btn-on-color" href={project.repo} target="_blank" rel="noopener">GitHub →</a>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-md);
    padding: var(--s-xl);
    border-radius: var(--r-xl);
    color: var(--c-ink);
  }
  .featured {
    grid-column: 1 / -1;
  }
  .tone-pink { background: var(--c-pink); }
  .tone-teal { background: var(--c-teal); }
  .tone-lavender { background: var(--c-lavender); }
  .tone-peach { background: var(--c-peach); }
  .tone-ochre { background: var(--c-ochre); }
  .tone-cream { background: var(--c-surface-card); }
  .dark {
    color: var(--c-on-primary);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-xxs);
  }
  .pill {
    background: rgba(255, 250, 240, 0.85);
  }
  h3 {
    font-size: var(--t-display-sm);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: inherit;
    word-break: keep-all;
  }
  .featured h3 {
    font-size: var(--t-display-md);
  }
  .summary {
    color: inherit;
    opacity: 0.92;
    max-width: 40em;
    word-break: keep-all;
    flex: 1;
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-xxs) var(--s-sm);
    padding: 0;
    list-style: none;
    font-size: var(--t-caption);
    font-weight: 500;
    opacity: 0.85;
  }
  .stack li::before {
    content: '#';
    opacity: 0.6;
  }
</style>
