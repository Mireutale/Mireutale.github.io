---
import { getCollection, render } from 'astro:content';
import ProjectDetail from './ProjectDetail.astro';

const entries = await getCollection('projects');
// 주요 프로젝트 먼저, 그 안에서는 최신순
entries.sort((a, b) => Number(!!b.data.featured) - Number(!!a.data.featured) || b.data.period.localeCompare(a.data.period));
const projects = await Promise.all(
  entries.map(async (e) => ({ ...e.data, id: e.id, Content: (await render(e)).Content })),
);
---

<section id="projects" class="section" aria-labelledby="projects-heading">
  <div class="container">
    <h2 id="projects-heading" class="section-title display">프로젝트</h2>
    <p class="quote no-print">서비스 기획·설계부터 백엔드·프론트엔드 개발, AI와 인프라 운영까지. 프로젝트별 담당 작업과 문제 해결 과정을 정리했습니다.</p>
    <ul class="grid no-print">
      {
        projects.map((p) => (
          <li class:list={[{ featured: p.featured }]}>
            <button class="card" type="button" data-target={`project-${p.id}`} aria-label={`${p.name} 상세 보기`}>
              {p.image && <img class="thumb" src={p.image} alt={`${p.name} 화면`} loading="lazy" />}
              <span class="card-body">
                <span class="name">{p.name}</span>
                <span class="meta">
                  <span class="pill">{p.period}</span>
                  <span class="pill">{p.type} 프로젝트</span>
                  {p.role && <span class="pill accent">{p.role}</span>}
                </span>
                <span class="summary">{p.summary}</span>
                {(p.ownStack || p.stack) && <span class="stack-line">{(p.ownStack || p.stack)!.join(' · ')}</span>}
              </span>
            </button>
          </li>
        ))
      }
    </ul>
    <div class="print-only">
      {
        projects.map((p) => (
          <article class="detail">
            <ProjectDetail project={p} variant="print" />
          </article>
        ))
      }
    </div>
  </div>

  {
    projects.map((p) => (
      <dialog class="modal" id={`project-${p.id}`} aria-labelledby={`project-${p.id}-title`}>
        <div class="modal-body" tabindex="-1">
        <form method="dialog">
          <button class="close" type="submit" aria-label="닫기">×</button>
        </form>
        <ProjectDetail project={p} variant="modal" />
        </div>
      </dialog>
    ))
  }
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('#projects button[data-target]').forEach((card) => {
    card.addEventListener('click', () => {
      const dialog = document.getElementById(card.dataset.target ?? '') as HTMLDialogElement | null;
      dialog?.showModal();
      dialog?.querySelector<HTMLElement>('.modal-body')?.focus({ preventScroll: true });
    });
  });
  document.querySelectorAll<HTMLDialogElement>('.modal').forEach((dialog) => {
    dialog.addEventListener('close', () => {
      (document.activeElement as HTMLElement | null)?.blur();
    });
  });

</script>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: var(--s-md);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .grid li {
    grid-column: span 2;
  }
  .grid li.featured {
    grid-column: span 3;
  }
  .card {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 1px solid var(--c-hairline);
    border-radius: var(--r-lg);
    background: var(--c-canvas);
    color: var(--c-body);
    font: inherit;
    text-align: center;
    cursor: pointer;
    overflow: hidden;
    transition: transform 150ms ease, box-shadow 150ms ease;
  }
  .card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(10, 10, 10, 0.08);
  }
  .thumb {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    border-bottom: 1px solid var(--c-hairline);
  }
  .card-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--s-sm);
    flex: 1;
    padding: var(--s-lg) var(--s-md);
  }
  .name {
    font-size: var(--t-title-md);
    font-weight: 600;
    color: var(--c-ink);
    word-break: keep-all;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--s-xxs);
  }
  .accent {
    background: var(--c-lavender);
    word-break: keep-all;
  }
  .stack-line {
    margin-top: auto;
    font-size: var(--t-caption-upper);
    color: var(--c-muted);
    word-break: keep-all;
  }
  .summary {
    font-size: var(--t-body-sm);
    word-break: keep-all;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .modal {
    width: min(100vw - 32px, 1440px);
    height: 96vh;
    max-height: 96vh;
    padding: 0;
    border: 0;
    border-radius: var(--r-xl);
    background: var(--c-canvas);
    color: var(--c-body);
    overflow: hidden;
  }
  .modal-body:focus,
  .close:focus:not(:focus-visible),
  .card:focus:not(:focus-visible) {
    outline: none;
  }
  .modal-body {
    height: 100%;
    max-height: 96vh;
    padding: var(--s-xl);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  /* 트랙 박스 없이 모달 가장자리에서 thumb만 보이게. 둥근 모서리 밖으로 나가지 않도록 위아래 범위를 radius만큼 줄임 */
  .modal-body::-webkit-scrollbar {
    width: 10px;
  }
  .modal-body::-webkit-scrollbar-track {
    background: transparent;
    margin-block: var(--r-xl);
  }
  .modal-body::-webkit-scrollbar-thumb {
    border: 3px solid transparent;
    border-radius: var(--r-pill);
    background: var(--c-muted-soft) padding-box;
  }
  @supports not selector(::-webkit-scrollbar) {
    .modal-body {
      scrollbar-width: thin;
      scrollbar-color: var(--c-muted-soft) transparent;
    }
  }
  /* 넓은 창에서는 배너를 왼쪽, 제목·지표를 오른쪽에 두어 배너가 잘리지 않고 첫 화면에 본문이 보이게 */
  @media (min-width: 900px) {
    .modal-body :global(.detail-head) {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: var(--s-xl);
      align-items: center;
      padding-right: var(--s-xl);
    }
    .modal-body :global(.detail-banner) {
      aspect-ratio: 16 / 9;
      margin-bottom: 0;
    }
    /* 오른쪽 정보는 가운데 정렬하고 블록 사이를 띄워 몰려 보이지 않게 */
    .modal-body :global(.head-info) {
      display: flex;
      flex-direction: column;
      gap: var(--s-md);
      text-align: center;
    }
    .modal-body :global(.head-info > *) {
      margin: 0;
    }
    .modal-body :global(.head-info .title-row),
    .modal-body :global(.head-info .stack) {
      justify-content: center;
    }
    .modal-body :global(.head-info .stack) {
      gap: var(--s-xs);
    }
  }
  .modal::backdrop {
    background: rgba(10, 10, 10, 0.5);
  }
  /* 창 오른쪽 위 모서리에 두고, 스크롤해도 따라오게 */
  .modal form {
    position: sticky;
    top: var(--s-sm);
    z-index: 2;
    display: flex;
    justify-content: flex-end;
    height: 0;
  }
  .close {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin: calc(var(--s-sm) - var(--s-xl)) calc(var(--s-sm) - var(--s-xl)) 0 0;
    border: 1px solid var(--c-hairline);
    border-radius: var(--r-pill);
    background: var(--c-canvas);
    box-shadow: 0 4px 12px rgba(10, 10, 10, 0.12);
    font-size: 22px;
    line-height: 1;
    color: var(--c-ink);
    cursor: pointer;
    transition: transform 150ms ease;
  }
  .close:hover {
    transform: scale(1.08);
  }
  .detail {
    margin-top: var(--s-lg);
    padding: var(--s-xl);
    border: 1px solid var(--c-hairline);
    border-radius: var(--r-xl);
    background: var(--c-canvas);
  }
  @media print {
    .detail {
      break-inside: auto;
      margin-top: 14px;
      padding: 18px;
    }
  }
  @media (max-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .grid li,
    .grid li.featured {
      grid-column: span 1;
    }
  }
  @media (max-width: 600px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
