---
import { projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';

const featured = projects.filter((p) => p.featured);
const rest = projects.filter((p) => !p.featured);
---

<section id="projects" aria-labelledby="projects-heading">
  <h2 id="projects-heading" class="section-bar label">Featured Project</h2>
  <div class="body">
    {featured.map((p) => <ProjectCard project={p} />)}
  </div>

  <h2 class="section-bar label">Other Projects <span class="count micro">{String(rest.length).padStart(2, '0')}</span></h2>
  <div class="body list">
    {rest.map((p) => <ProjectCard project={p} />)}
  </div>
</section>

<style>
  .body {
    padding: var(--s-sm);
    background: var(--c-periwinkle);
    box-shadow: var(--bevel-plate);
  }
  .list {
    display: grid;
    gap: var(--s-sm);
  }
  .count {
    margin-left: auto;
    color: var(--c-surface);
  }
</style>
