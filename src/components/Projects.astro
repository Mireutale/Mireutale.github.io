---
import { getCollection, render } from 'astro:content';
import ProjectDetail from './ProjectDetail.astro';
import { imageSize } from '../lib/image';

// featured = 앞에 둘 프로젝트 id (페이지마다 순서가 다름). 나머지는 최신순으로 뒤에
interface Props {
  featured: string[];
}

const { featured } = Astro.props;
const entries = await getCollection('projects');
const unknown = featured.filter((id) => !entries.some((e) => e.id === id));
if (unknown.length) throw new Error(`featured에 없는 프로젝트가 있습니다: ${unknown.join(', ')}`);

// featured에 적은 순서대로, 나머지는 최신순
const rank = (id: string) => (featured.includes(id) ? featured.indexOf(id) : featured.length);
entries.sort((a, b) => rank(a.id) - rank(b.id) || b.data.period.localeCompare(a.data.period));
const projects = await Promise.all(
  entries.map(async (e) => ({
    ...e.data,
    id: e.id,
    Content: (await render(e)).Content,
    thumbSize: e.data.image ? await imageSize(e.data.image) : undefined,
  })),
);
---

<section id="projects" class="section" aria-labelledby="projects-heading">
  <div class="container">
    <h2 id="projects-heading" class="section-title display">프로젝트</h2>
    <p class="quote no-print">서비스 기획·설계부터 백엔드·프론트엔드 개발, AI와 인프라 운영까지. 프로젝트별 담당 작업과 문제 해결 과정을 정리했습니다.</p>
    <ul class="grid no-print">
      {
        projects.map((p) => (
          <li>
            <button class="card" type="button" data-target={`project-${p.id}`} aria-label={`${p.name} 상세 보기`}>
              <span class="thumb-wrap">
                {p.image && <img class="thumb" src={p.image} alt="" loading="lazy" {...p.thumbSize} style={p.imagePosition && `object-position: ${p.imagePosition}`} />}
              </span>
              <span class="card-body">
                <span class="name">{p.name} <span class="arrow" aria-hidden="true">↗</span></span>
                <span class="meta">{p.period} · {p.type} 프로젝트{p.role && ` · ${p.role}`}</span>
                <span class="summary">{p.summary}</span>
                {(p.award || p.highlights) && (
                  <span class="proof">
                    {p.award && <span class="award">🏆 {p.award}</span>}
                    {p.highlights?.map((h) => (
                      <span class="metric"><strong>{h.value}</strong> {h.label}</span>
                    ))}
                  </span>
                )}
                {(p.ownStack || p.stack) && (
                  <span class="tags">
                    {(p.ownStack || p.stack)!.map((t) => <span class="pill">{t}</span>)}
                  </span>
                )}
              </span>
            </button>
          </li>
        ))
      }
    </ul>
    <div class="print-only">
      {
        projects.map((p) => (
          <article class="detail">
            <ProjectDetail project={p} variant="print" />
          </article>
        ))
      }
    </div>
  </div>

  {
    projects.map((p) => (
      <dialog class="modal" id={`project-${p.id}`} aria-labelledby={`project-${p.id}-title`}>
        <div class="modal-body" tabindex="-1">
        <form method="dialog">
          <button class="close" type="submit" aria-label="닫기">×</button>
        </form>
        <ProjectDetail project={p} variant="modal" />
        </div>
      </dialog>
    ))
  }
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('#projects button[data-target]').forEach((card) => {
    card.addEventListener('click', () => {
      const dialog = document.getElementById(card.dataset.target ?? '') as HTMLDialogElement | null;
      dialog?.showModal();
      dialog?.querySelector<HTMLElement>('.modal-body')?.focus({ preventScroll: true });
    });
  });
  document.querySelectorAll<HTMLDialogElement>('.modal').forEach((dialog) => {
    dialog.addEventListener('close', () => {
      (document.activeElement as HTMLElement | null)?.blur();
    });
  });

</script>

<style>
  /* 카드 안쪽 여백만큼 바깥으로 빼서 썸네일·본문 위치를 다른 섹션과 맞춤 (호버 배경만 여백까지 번짐) */
  .grid {
    display: grid;
    gap: var(--s-xs);
    margin: 0 calc(-1 * var(--s-md));
    padding: 0;
    list-style: none;
  }
  /* 썸네일 목록형: 왼쪽 작은 썸네일, 오른쪽 제목·한 줄 정보·요약·근거 수치·기술 */
  .card {
    display: grid;
    grid-template-columns: var(--col-side) minmax(0, 1fr);
    gap: var(--s-lg);
    width: 100%;
    padding: var(--s-md);
    border: 0;
    border-radius: var(--r-lg);
    background: none;
    color: var(--c-body);
    font: inherit;
    text-align: left;
    cursor: pointer;
    transition: background 150ms ease;
  }
  .card:hover {
    background: var(--c-surface-soft);
  }
  .card:hover .name {
    color: var(--c-link);
  }
  .card:hover .arrow {
    transform: translate(2px, -2px);
  }
  .thumb-wrap {
    padding-top: 4px;
  }
  .thumb {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    object-position: top;
    border: 1px solid var(--c-hairline);
    border-radius: var(--r-sm);
    background: var(--c-surface-card);
  }
  .card-body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--s-xs);
    min-width: 0;
  }
  .name {
    font-size: var(--t-title-lg);
    font-weight: 600;
    color: var(--c-ink);
    word-break: keep-all;
    transition: color 150ms ease;
  }
  .arrow {
    display: inline-block;
    font-size: 0.8em;
    transition: transform 150ms ease;
  }
  .meta {
    font-size: var(--t-caption);
    color: var(--c-muted);
    word-break: keep-all;
  }
  .summary {
    max-width: 44em;
    word-break: keep-all;
  }
  /* 근거: 수상과 핵심 수치를 한 줄씩 */
  .proof {
    display: flex;
    flex-direction: column;
    gap: 2px;
    font-size: var(--t-body-sm);
    color: var(--c-muted);
    word-break: keep-all;
  }
  .award {
    font-weight: 600;
    color: var(--c-body-strong);
  }
  .metric strong {
    font-weight: 600;
    color: var(--c-ink);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-xxs);
    margin-top: var(--s-xxs);
  }

  .modal {
    width: min(100vw - 32px, 1440px);
    height: 96vh;
    max-height: 96vh;
    padding: 0;
    border: 0;
    border-radius: var(--r-xl);
    background: var(--c-canvas);
    color: var(--c-body);
    overflow: hidden;
  }
  .modal-body:focus,
  .close:focus:not(:focus-visible),
  .card:focus:not(:focus-visible) {
    outline: none;
  }
  .modal-body {
    height: 100%;
    max-height: 96vh;
    padding: var(--s-xl);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  /* 트랙 박스 없이 모달 가장자리에서 thumb만 보이게. 둥근 모서리 밖으로 나가지 않도록 위아래 범위를 radius만큼 줄임 */
  .modal-body::-webkit-scrollbar {
    width: 10px;
  }
  .modal-body::-webkit-scrollbar-track {
    background: transparent;
    margin-block: var(--r-xl);
  }
  .modal-body::-webkit-scrollbar-thumb {
    border: 3px solid transparent;
    border-radius: var(--r-pill);
    background: var(--c-muted-soft) padding-box;
  }
  @supports not selector(::-webkit-scrollbar) {
    .modal-body {
      scrollbar-width: thin;
      scrollbar-color: var(--c-muted-soft) transparent;
    }
  }
  /* 넓은 창에서는 배너를 왼쪽, 제목·지표를 오른쪽에 두어 배너가 잘리지 않고 첫 화면에 본문이 보이게 */
  @media (min-width: 900px) {
    .modal-body :global(.detail-head) {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: var(--s-xl);
      align-items: center;
      padding-right: var(--s-xl);
    }
    .modal-body :global(.detail-banner) {
      aspect-ratio: 16 / 9;
      margin-bottom: 0;
    }
    /* 오른쪽 정보는 가운데 정렬하고 블록 사이를 띄워 몰려 보이지 않게 */
    .modal-body :global(.head-info) {
      display: flex;
      flex-direction: column;
      gap: var(--s-md);
      text-align: center;
    }
    .modal-body :global(.head-info > *) {
      margin: 0;
    }
    .modal-body :global(.head-info .title-row),
    .modal-body :global(.head-info .stack) {
      justify-content: center;
    }
    .modal-body :global(.head-info .stack) {
      gap: var(--s-xs);
    }
  }
  .modal::backdrop {
    background: rgba(10, 10, 10, 0.5);
  }
  /* 창 오른쪽 위 모서리에 두고, 스크롤해도 따라오게 */
  .modal form {
    position: sticky;
    top: var(--s-sm);
    z-index: 2;
    display: flex;
    justify-content: flex-end;
    height: 0;
  }
  .close {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin: calc(var(--s-sm) - var(--s-xl)) calc(var(--s-sm) - var(--s-xl)) 0 0;
    border: 1px solid var(--c-hairline);
    border-radius: var(--r-pill);
    background: var(--c-canvas);
    box-shadow: 0 4px 12px rgba(10, 10, 10, 0.12);
    font-size: 22px;
    line-height: 1;
    color: var(--c-ink);
    cursor: pointer;
    transition: transform 150ms ease;
  }
  .close:hover {
    transform: scale(1.08);
  }
  .detail {
    margin-top: var(--s-lg);
    padding: var(--s-xl);
    border: 1px solid var(--c-hairline);
    border-radius: var(--r-xl);
    background: var(--c-canvas);
  }
  @media print {
    .detail {
      break-inside: auto;
      margin-top: 14px;
      padding: 18px;
    }
  }
  @media (max-width: 640px) {
    .card {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-sm);
    }
    .thumb-wrap {
      max-width: 280px;
    }
  }
</style>
