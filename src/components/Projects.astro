---
import { projects } from '../data/projects';
import ProjectCard from './ProjectCard.astro';

const tones = ['pink', 'teal', 'lavender', 'peach', 'ochre', 'cream'] as const;
---

<section id="projects" class="section" aria-labelledby="projects-heading">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Projects</p>
      <h2 id="projects-heading" class="section-title display">프로젝트</h2>
    </div>
    <div class="grid">
      {projects.map((p, i) => <ProjectCard project={p} tone={tones[i % tones.length]} />)}
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-md);
  }
  @media (max-width: 768px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
