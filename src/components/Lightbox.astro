---
// 프로젝트 상세의 사진을 클릭하면 원본 크기로 크게 보여 주는 창. 페이지마다 하나만 둠
---

<dialog class="lightbox" aria-label="사진 크게 보기">
  <form method="dialog">
    <button class="lightbox-close" type="submit" aria-label="닫기">×</button>
  </form>
  <img class="lightbox-img" alt="" />
</dialog>

<script>
  const lightbox = document.querySelector<HTMLDialogElement>('.lightbox');
  const lightboxImg = lightbox?.querySelector<HTMLImageElement>('.lightbox-img');

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    if (!lightbox || !lightboxImg) return;
    if (target.matches('.zoomable img')) {
      const img = target as HTMLImageElement;
      lightboxImg.src = img.currentSrc || img.src;
      lightboxImg.alt = img.alt;
      lightbox.showModal();
      return;
    }
    // 사진 바깥(배경)을 누르면 닫힘
    if (target === lightbox) lightbox.close();
  });
</script>

<style>
  .lightbox {
    max-width: 100vw;
    max-height: 100vh;
    width: 100vw;
    height: 100vh;
    padding: var(--s-lg);
    border: 0;
    background: transparent;
  }
  .lightbox[open] {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lightbox::backdrop {
    background: rgba(10, 10, 10, 0.85);
  }
  .lightbox-img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    border-radius: var(--r-md);
    background: var(--c-canvas);
  }
  .lightbox-close {
    position: fixed;
    top: var(--s-md);
    right: var(--s-md);
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.15);
    color: #fff;
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
  }
  .lightbox-close:hover {
    background: rgba(255, 255, 255, 0.3);
  }
</style>
