---
import { imageSize } from '../lib/image';
import type { Project } from '../lib/project';

// 모달·인쇄·풀 페이지가 공유하는 프로젝트 상세
interface Props {
  project: Project;
  variant: 'modal' | 'print' | 'page';
  // 직무 페이지(backend 등)에서 열었으면 전체 페이지도 그 직무 본문으로 연결
  track?: string;
}

const { project: p, variant, track } = Astro.props;
const Title = variant === 'page' ? 'h1' : 'h3';
const showBanner = !!p.image;
const bannerSize = p.image ? await imageSize(p.image) : undefined;
---

<div class:list={['detail-head', { split: variant !== 'print' }]}>
{showBanner && <img class="detail-banner" src={p.image} alt={`${p.name} 배너`} {...bannerSize} />}
<div class="head-info">
<p class="modal-meta">
  {p.period} · {p.type} 프로젝트{p.role && ` · ${p.role}`}
</p>
<div class="title-row">
  <Title id={variant === 'modal' ? `project-${p.id}-title` : undefined} class="title display">{p.name}</Title>
  {variant !== 'print' && p.repo && (
    <a class="btn btn-primary" href={p.repo} target="_blank" rel="noopener">GitHub →</a>
  )}
  {variant !== 'print' && p.demo && (
    <a class="btn btn-primary" href={p.demo} target="_blank" rel="noopener">▶ 시연 영상</a>
  )}
  {variant === 'modal' && (
    <a class="btn btn-secondary" href={`${track ? `/${track}` : ''}/projects/${p.id}/`}>전체 페이지 ↗</a>
  )}
  </div>
{p.award && <p class="award">🏆 {p.award}</p>}
{p.highlights && p.highlights.length > 0 && (
  <dl class="highlights">
    {p.highlights.map((h) => (
      <div>
        <dt>{h.label}</dt>
        <dd>{h.value}</dd>
      </div>
    ))}
  </dl>
)}
{p.ownStack && p.ownStack.length > 0 && (
  <p class="stack-label">직접 사용한 기술</p>
  <ul class="stack" aria-label="직접 사용한 기술">
    {p.ownStack.map((s) => <li class="pill">{s}</li>)}
  </ul>
)}
</div>
</div>
<div class="md zoomable">
  <h2>소개</h2>
  <p>{p.summary.split(/(?<=다\.)\s+/).map((sentence, index) => <>{index > 0 && <br />}{sentence}</>)}</p>
  {p.Content && <p.Content />}
</div>
{p.gallery && p.gallery.length > 0 && (
  <div class="md zoomable">
    <h2>화면</h2>
    <ul class="gallery">
      {p.gallery.map((g) => (
        <li>
          <figure>
            <figcaption>{g.caption}</figcaption>
            <img src={g.src} alt={g.caption} loading="lazy" />
          </figure>
        </li>
      ))}
    </ul>
  </div>
)}
{p.Learned && (
  <div class="learned">
    <h2>배운 것</h2>
    <p.Learned />
  </div>
)}
{variant === 'print' && p.repo && <p class="repo-line">GitHub · {p.repo.replace(/^https?:\/\//, '')}</p>}

<style>
  .modal-meta {
    font-size: var(--t-body-sm);
    color: var(--c-muted);
  }
  .title {
    font-size: var(--t-display-md);
    flex: 0 1 auto;
    min-width: 0;
    margin-top: 0;
  }
  .title-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-xs) var(--s-md);
    margin-top: var(--s-xxs);
  }
  .title-row .btn {
    flex: none;
    height: 30px;
    padding: 6px 12px;
  }
  .award {
    margin-top: var(--s-sm);
    font-size: var(--t-body-sm);
    font-weight: 600;
    color: var(--c-body-strong);
  }
  .highlights {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: var(--s-xs);
    margin: var(--s-md) 0 0;
  }
  .highlights div {
    display: flex;
    flex-direction: column-reverse;
    gap: 2px;
    padding: var(--s-sm) var(--s-md);
    border-radius: var(--r-md);
    background: var(--c-surface-card);
  }
  .highlights dd {
    margin: 0;
    font-size: var(--t-title-lg);
    font-weight: 600;
    color: var(--c-ink);
    letter-spacing: -0.01em;
  }
  .highlights dt {
    font-size: var(--t-caption);
    color: var(--c-muted);
    word-break: keep-all;
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-xxs);
    margin: var(--s-sm) 0 0;
    padding: 0;
    list-style: none;
  }
  .stack .pill {
    background: var(--c-canvas);
    border: 1px solid var(--c-hairline);
  }
  .stack-label {
    margin-top: var(--s-sm);
    color: var(--c-muted);
    font-size: var(--t-caption);
  }
  .md :global(h2) {
    margin: var(--s-xl) 0 var(--s-sm);
    font-size: var(--t-caption-upper);
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--c-muted);
  }
  .md :global(h3) {
    margin: var(--s-lg) 0 var(--s-sm);
  }
  .md :global(p),
  .md :global(li) {
    word-break: keep-all;
  }
  .md :global(p + p),
  .md :global(ul + p),
  .md :global(ol + p),
  .md :global(p + ul),
  .md :global(p + ol) {
    margin-top: var(--s-md);
  }
  .md :global(ul) {
    padding-left: 1.2em;
  }
  .md :global(img) {
    display: block;
    width: 100%;
    margin-block: var(--s-sm);
    border: 1px solid var(--c-hairline);
    border-radius: var(--r-md);
  }
  .md :global(li) {
    margin-block: 6px;
  }
  .zoomable :global(img) {
    cursor: zoom-in;
  }
  .gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-md);
    padding: 0;
    list-style: none;
  }
  .md .gallery li {
    margin: 0;
  }
  .gallery figure {
    margin: 0;
  }
  .gallery figcaption {
    font-size: var(--t-body-sm);
    color: var(--c-muted);
  }
  .md .gallery img {
    margin-block: var(--s-xxs) 0;
  }
  @media (max-width: 480px) {
    .gallery {
      grid-template-columns: 1fr;
    }
  }
  .md :global(table) {
    width: 100%;
    margin-block: var(--s-sm);
    border-collapse: collapse;
    font-size: var(--t-body-sm);
  }
  .md :global(th),
  .md :global(td) {
    padding: 6px 8px;
    border-bottom: 1px solid var(--c-hairline);
    text-align: left;
    word-break: keep-all;
  }
  .md :global(th) {
    color: var(--c-ink);
    font-weight: 600;
  }
  .learned {
    margin-top: var(--s-xl);
    padding-top: var(--s-lg);
    border-top: 2px solid var(--c-ink);
  }
  .learned h2 {
    margin: 0 0 var(--s-xs);
    font-size: var(--t-title-md);
    font-weight: 600;
    color: var(--c-ink);
  }
  .learned :global(p),
  .learned :global(li) {
    word-break: keep-all;
    color: var(--c-body-strong);
  }
  .learned :global(p + p),
  .learned :global(ul + p),
  .learned :global(p + ul) {
    margin-top: var(--s-md);
  }
  .learned :global(ul) {
    padding-left: 1.2em;
  }
  .learned :global(li) {
    margin-block: 6px;
  }
  .detail-banner {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 7;
    object-fit: cover;
    object-position: top;
    margin-bottom: var(--s-md);
    border: 1px solid var(--c-hairline);
    border-radius: var(--r-md);
    break-inside: avoid;
  }
  /* 모달·전체 페이지 공통: 넓은 창에서는 배너를 왼쪽, 제목·지표를 오른쪽에 두어 배너가 잘리지 않고 첫 화면에 본문이 보이게 */
  @media (min-width: 900px) {
    .split {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      gap: var(--s-xl);
      align-items: center;
    }
    .split .detail-banner {
      aspect-ratio: 16 / 9;
      margin-bottom: 0;
    }
    /* 오른쪽 정보는 가운데 정렬하고 블록 사이를 띄워 몰려 보이지 않게 */
    .split .head-info {
      display: flex;
      flex-direction: column;
      gap: var(--s-md);
      text-align: center;
    }
    .split .head-info > * {
      margin: 0;
    }
    .split .title-row,
    .split .stack {
      justify-content: center;
    }
    .split .stack {
      gap: var(--s-xs);
    }
  }
  .repo-line {
    margin-top: var(--s-md);
    font-size: var(--t-caption);
    color: var(--c-muted);
  }
  @media print {
    .title {
      break-after: avoid;
    }
    .highlights div {
      padding: 6px 10px;
    }
    .highlights dd {
      font-size: 12pt;
    }
    .gallery li {
      break-inside: avoid;
    }
    .md :global(img) {
      max-height: 90mm;
      width: auto;
      max-width: 100%;
      margin-inline: auto;
      break-inside: avoid;
    }
    .gallery {
      display: grid !important;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
    }
    .gallery img {
      width: 100%;
      max-height: none;
      margin: 0;
    }
    .gallery figcaption {
      font-size: 8pt;
    }
  }
</style>
