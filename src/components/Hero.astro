---
import { getEntry } from 'astro:content';
import type { AstroComponentFactory } from 'astro/runtime/server/index.js';

// 소개 문단과 직무명은 페이지마다 다르고, 이름·연락처는 intro.md 하나를 공유
interface Props {
  role: string;
  Content: AstroComponentFactory;
}

const { role, Content } = Astro.props;
const profile = (await getEntry('profile', 'intro'))!.data;
---

<header id="top" class="header container">
  <img class="avatar" src="/img/profile/avatar.jpeg" alt={`${profile.name} 프로필 사진`} width="160" height="160" />
  <div class="body">
    <div class="top">
      <div>
        <h1 class="display">{profile.name}</h1>
        <p class="role">{role}</p>
      </div>
      <div class="contact">
        <p>Email: <a href={`mailto:${profile.email}`}>{profile.email}</a></p>
        <p>GitHub: <a href={profile.github} target="_blank" rel="noopener">{profile.github.replace(/^https?:\/\//, '')}</a></p>
      </div>
    </div>
    <div class="text">
      <Content />
    </div>
  </div>
</header>


<style>
  .header {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: var(--s-xl);
    align-items: start;
    padding-block: var(--s-section) var(--s-xxl);
  }
  .avatar {
    display: block;
    width: 160px;
    height: 160px;
    margin-inline: auto;
    border-radius: 50%;
    object-fit: cover;
    background: var(--c-surface-card);
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: var(--s-lg);
    margin-bottom: var(--s-xl);
  }
  h1 {
    font-size: var(--t-display-xl);
    letter-spacing: -0.035em;
  }
  .role {
    margin-top: var(--s-xxs);
    font-size: var(--t-title-lg);
    font-weight: 600;
    color: var(--c-muted);
  }
  .contact {
    display: grid;
    gap: var(--s-xxs);
    justify-items: end;
    text-align: right;
    font-size: var(--t-caption);
    color: var(--c-muted);
  }
  .contact a {
    word-break: break-all;
  }
  .text {
    display: grid;
    gap: var(--s-md);
    max-width: 40em;
    word-break: keep-all;
  }
  /* 첫 문단 = 한 줄 소개 */
  .text > :global(p:first-child) {
    font-size: var(--t-title-md);
    font-weight: 600;
    color: var(--c-body-strong);
  }
  /* 목록 1단계 = 성향 묶음. 불릿 없이 첫 줄을 소제목처럼 */
  .text > :global(ul) {
    display: grid;
    gap: var(--s-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  /* 글자 아래쪽만 칠하는 형광펜. 줄이 바뀌어도 줄마다 이어지게 inline */
  .text > :global(ul > li > p) {
    display: inline;
    font-size: var(--t-body-md);
    font-weight: 600;
    color: var(--c-ink);
    background: linear-gradient(transparent 60%, color-mix(in srgb, var(--mark-color) 55%, transparent) 60%); /* global.css .mark와 같은 형광펜 */
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }
  /* 2단계 = 일하는 방식 */
  .text :global(ul ul) {
    display: grid;
    gap: var(--s-xxs);
    margin-top: var(--s-xs);
    padding-left: 1.1em;
    list-style: disc;
    font-size: var(--t-body-sm);
    color: var(--c-body);
  }
  .text :global(ul ul li::marker) {
    color: var(--c-muted-soft);
  }
  /* 3단계 = 근거 수치. 불릿 대신 왼쪽 선으로 묶음 */
  .text :global(ul ul ul) {
    gap: var(--s-xs);
    margin-block: var(--s-xs);
    padding-left: var(--s-md);
    border-left: 2px solid var(--c-hairline);
    list-style: none;
    color: var(--c-muted);
  }
  .text :global(ul ul ul strong) {
    color: var(--c-ink);
    white-space: nowrap;
  }
  @media (max-width: 768px) {
    .header {
      grid-template-columns: 1fr;
    }
    .contact {
      justify-items: start;
      text-align: left;
    }
  }
  @media print {
    .header {
      grid-template-columns: 140px 1fr;
      gap: 24px;
      padding-block: 8px 24px;
    }
    .avatar {
      width: 100px;
      height: 100px;
    }
    h1 {
      font-size: 28pt;
    }
    .top {
      margin-bottom: 16px;
    }
    .contact {
      justify-items: end;
      text-align: right;
    }
    .text {
      max-width: none;
    }
    .text :global(p:first-child) {
      font-size: 11pt;
    }
  }
</style>
