---
import { profile } from '../data/profile';
---

<header id="top" class="header container">
  <img class="avatar" src="/img/profile/avatar.jpeg" alt={`${profile.name} 프로필 사진`} width="160" height="160" />
  <div class="body">
    <div class="top">
      <div>
        <h1 class="display">{profile.name}</h1>
      </div>
      <div class="contact">
        <p>Email: <a href={`mailto:${profile.email}`}>{profile.email}</a></p>
        <p>GitHub: <a href={profile.github} target="_blank" rel="noopener">{profile.github.replace(/^https?:\/\//, '')}</a></p>
      </div>
    </div>
    <div class="text">
      {profile.about.map((p) => <p>{p}</p>)}
    </div>
    <ul class="traits">
      {profile.traits.map((t) => <li>{t.text}</li>)}
    </ul>
  </div>
</header>


<style>
  .header {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: var(--s-xl);
    align-items: start;
    padding-block: var(--s-section) var(--s-xxl);
  }
  .avatar {
    display: block;
    width: 160px;
    height: 160px;
    margin-inline: auto;
    border-radius: 50%;
    object-fit: cover;
    background: var(--c-surface-card);
  }
  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: var(--s-lg);
    margin-bottom: var(--s-xl);
  }
  h1 {
    font-size: var(--t-display-xl);
    letter-spacing: -0.035em;
  }
  .contact {
    display: grid;
    gap: var(--s-xxs);
    justify-items: end;
    text-align: right;
    font-size: var(--t-caption);
    color: var(--c-muted);
  }
  .contact a {
    word-break: break-all;
  }
  .text {
    display: grid;
    gap: var(--s-md);
    max-width: 40em;
    word-break: keep-all;
  }
  .text p:first-child {
    font-size: var(--t-title-md);
    font-weight: 600;
    color: var(--c-body-strong);
  }
  .traits {
    display: grid;
    gap: var(--s-xxs);
    padding-left: 1.2em;
    margin-top: var(--s-md);
    max-width: 40em;
    font-size: var(--t-body-sm);
    word-break: keep-all;
  }
  @media (max-width: 768px) {
    .header {
      grid-template-columns: 1fr;
    }
    .contact {
      justify-items: start;
      text-align: left;
    }
  }
  @media print {
    .header {
      grid-template-columns: 140px 1fr;
      gap: 24px;
      padding-block: 8px 24px;
    }
    .avatar {
      width: 100px;
      height: 100px;
    }
    h1 {
      font-size: 28pt;
    }
    .top {
      margin-bottom: 16px;
    }
    .contact {
      justify-items: end;
      text-align: right;
    }
    .text,
    .traits {
      max-width: none;
    }
    .text p:first-child {
      font-size: 11pt;
    }
  }
</style>
