---
import { profile } from '../data/profile';
---

<section id="top" class="hero container" aria-labelledby="hero-heading">
  <div class="field">
    <div class="copy">
      <p class="label eyebrow">{profile.nameEn} · Backend Developer</p>
      <h1 id="hero-heading" class="boxart">{profile.tagline}</h1>
      <p class="tagline">{profile.intro}</p>
      <a class="go" href="#projects"><span class="arrow-disc">▶</span><span class="label">Play It On · Projects</span></a>
    </div>
    <dl class="facts">
      {
        profile.facts.map((f) => (
          <div class="fact">
            <dt class="label">{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .hero {
    padding-top: var(--s-lg);
  }
  .field {
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: var(--s-lg);
    padding: var(--s-lg);
    border-radius: var(--r-md);
    background-color: var(--c-lavender);
    background-image:
      linear-gradient(90deg, rgba(61, 79, 151, 0.18) 1px, transparent 1px),
      linear-gradient(0deg, rgba(61, 79, 151, 0.18) 1px, transparent 1px),
      radial-gradient(circle at 20% 30%, rgba(255, 255, 255, 0.35), transparent 40%);
    background-size: 24px 24px, 24px 24px, 100% 100%;
    box-shadow: var(--bevel-plate);
  }
  .eyebrow {
    color: var(--c-ink);
    margin-bottom: var(--s-sm);
  }
  h1 {
    font-size: var(--t-display);
    word-break: keep-all;
  }
  .tagline {
    margin-top: var(--s-md);
    font-size: var(--t-tagline);
    font-weight: 700;
    line-height: 1.3;
    color: var(--c-ink);
    word-break: keep-all;
    max-width: 34em;
  }
  .go {
    display: inline-flex;
    align-items: center;
    gap: var(--s-sm);
    margin-top: var(--s-lg);
    color: var(--c-ink);
  }
  .facts {
    align-self: end;
    padding: var(--s-md);
    border-radius: var(--r-sm);
    background: var(--c-surface);
    box-shadow: 0 0 0 1px var(--c-hairline);
  }
  .fact {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: var(--s-sm);
    padding: var(--s-xs) 0;
    border-bottom: 1px dotted var(--c-muted-indigo);
    word-break: keep-all;
  }
  .fact:last-child {
    border-bottom: 0;
  }
  dt {
    color: var(--c-ink-soft);
    padding-top: 1px;
  }
  @media (max-width: 720px) {
    .field {
      grid-template-columns: 1fr;
    }
  }
</style>
