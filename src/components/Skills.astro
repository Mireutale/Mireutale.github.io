---
import { skills } from '../data/skills';
---

<section id="skills" class="section" aria-labelledby="skills-heading">
  <div class="container">
    <h2 id="skills-heading" class="section-title display">Skill</h2>
    <dl>
      {
        skills.map((g) => (
          <div class="row">
            <dt>{g.group}</dt>
            <dd>{g.items.join(', ')}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .row {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: var(--s-xl);
    padding-block: var(--s-sm);
    border-bottom: 1px solid var(--c-hairline-soft);
  }
  .row:last-child {
    border-bottom: 0;
  }
  dt {
    font-size: var(--t-caption-upper);
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--c-muted);
    padding-top: 2px;
  }
  dd {
    color: var(--c-body-strong);
    word-break: keep-all;
  }
  @media (max-width: 768px) {
    .row {
      grid-template-columns: 1fr;
      gap: var(--s-xxs);
    }
  }
  @media print {
    .row {
      grid-template-columns: 160px 1fr !important;
      gap: 16px;
      padding-block: 8px;
    }
  }
</style>
