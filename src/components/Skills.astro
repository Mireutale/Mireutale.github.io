---
import { skills } from '../lib/profile';

// order = 앞에 둘 분류 이름. 적지 않은 분류는 skills.md 순서대로 뒤에 붙음
interface Props {
  order?: string[];
}

const { order = [] } = Astro.props;
const unknown = order.filter((g) => !skills.some((s) => s.group === g));
if (unknown.length) throw new Error(`skillOrder에 없는 분류가 있습니다: ${unknown.join(', ')}`);
const rank = (group: string) => (order.includes(group) ? order.indexOf(group) : order.length);
const sorted = [...skills].sort((a, b) => rank(a.group) - rank(b.group));
---

<section id="skills" class="section" aria-labelledby="skills-heading">
  <div class="container">
    <h2 id="skills-heading" class="section-title display">기술</h2>
    <dl>
      {
        sorted.map((g) => (
          <div class="row">
            <dt>{g.group}</dt>
            <dd>{g.items.join(' · ')}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .row {
    display: grid;
    grid-template-columns: var(--col-side) 1fr;
    gap: var(--s-lg);
    padding-block: var(--s-sm);
    border-top: 1px solid var(--c-hairline);
  }
  dt {
    padding-top: 2px;
    font-size: var(--t-caption);
    font-weight: 500;
    color: var(--c-muted);
  }
  dd {
    margin: 0;
    font-weight: 500;
    color: var(--c-ink);
    word-break: keep-all;
  }
  @media (max-width: 768px) {
    .row {
      grid-template-columns: 1fr;
      gap: var(--s-xxs);
    }
  }
  @media print {
    .row {
      grid-template-columns: 160px 1fr !important;
      gap: 16px;
      padding-block: 8px;
    }
  }
</style>
