---
import { skills } from '../data/skills';
---

<section id="skills" class="section" aria-labelledby="skills-heading">
  <div class="container">
    <div class="section-head">
      <p class="eyebrow">Skill</p>
      <h2 id="skills-heading" class="section-title display">기술 스택</h2>
    </div>
    <dl>
      {
        skills.map((g) => (
          <div class="entry">
            <dt class="entry-side">
              <h3>{g.group}</h3>
            </dt>
            <dd class="entry-main">
              <ul class="tags">
                {g.items.map((s) => (
                  <li class="pill">{s}</li>
                ))}
              </ul>
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .entry {
    padding-block: var(--s-md);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-xs);
    padding: 0;
    list-style: none;
  }
</style>
