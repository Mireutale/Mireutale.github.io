---
import { skills } from '../data/skills';
---

<section id="skills" aria-labelledby="skills-heading">
  <h2 id="skills-heading" class="section-bar label">Skills</h2>
  <dl class="grid">
    {
      skills.map((g) => (
        <div class="sys-tile">
          <dt class="boxart">{g.group}</dt>
          <dd>
            <ul>
              {g.items.map((s) => (
                <li>{s}</li>
              ))}
            </ul>
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-sm);
    padding: var(--s-sm);
    background: var(--c-periwinkle);
    box-shadow: var(--bevel-plate);
  }
  .sys-tile {
    padding: var(--s-sm);
    border-radius: var(--r-sm);
    background-color: var(--c-periwinkle);
    background-image:
      linear-gradient(90deg, rgba(61, 79, 151, 0.2) 1px, transparent 1px),
      linear-gradient(0deg, rgba(61, 79, 151, 0.2) 1px, transparent 1px);
    background-size: 12px 12px;
    box-shadow: var(--bevel-plate);
  }
  dt {
    font-size: 16px;
    margin-bottom: var(--s-sm);
  }
  ul {
    padding: 0;
    list-style: none;
  }
  li {
    padding: 2px 0;
    border-bottom: 1px dotted var(--c-muted-indigo);
    font-weight: 700;
    color: var(--c-ink);
  }
  li:last-child {
    border-bottom: 0;
  }
  @media (max-width: 720px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
