---
import { profile } from '../data/profile';
const year = new Date().getFullYear();
---

<footer id="contact" class="section" aria-labelledby="contact-heading">
  <div class="container">
    <div class="box">
      <h2 id="contact-heading">함께 고민할 문제가 있다면<br />언제든 연락 주세요.</h2>
      <div class="links">
        <a class="btn btn-dark" href={`mailto:${profile.email}`}>{profile.email}</a>
        <a class="btn btn-ghost" href={profile.github} target="_blank" rel="noopener">github.com/Mireutale</a>
      </div>
    </div>
    <p class="copy">© {year} {profile.name}. Built with Astro.</p>
  </div>
</footer>

<style>
  .box {
    padding: clamp(2rem, 1.5rem + 3vw, 4rem);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }
  h2 {
    font-size: var(--text-section);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.025em;
    word-break: keep-all;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .copy {
    margin-top: 2rem;
    font-size: var(--text-sm);
    color: var(--color-muted);
    text-align: center;
  }
</style>
