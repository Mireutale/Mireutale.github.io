---
import { profile } from '../data/profile';
const year = new Date().getFullYear();
---

<footer id="contact">
  <div class="container">
    <div class="cta">
      <h2 class="display">함께 고민할 문제가 있다면<br />언제든 연락 주세요.</h2>
      <div class="actions">
        <a class="btn btn-primary" href={`mailto:${profile.email}`}>{profile.email}</a>
        <a class="btn btn-secondary" href={profile.github} target="_blank" rel="noopener">github.com/Mireutale</a>
      </div>
    </div>
    <p class="copy">© {year} {profile.name} · {profile.email} · References on request</p>
  </div>
</footer>

<style>
  footer {
    padding-block: var(--s-section) var(--s-xxl);
  }
  .cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-xl);
    padding: clamp(40px, 3rem + 3vw, 80px);
    border-radius: var(--r-xl);
    background: var(--c-surface-soft);
  }
  h2 {
    font-size: var(--t-display-md);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-sm);
  }
  .copy {
    margin-top: var(--s-xl);
    font-size: var(--t-body-sm);
    color: var(--c-muted);
    text-align: center;
  }
</style>
