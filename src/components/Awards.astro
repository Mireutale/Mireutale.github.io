---
import { profile } from '../data/profile';
---

<section id="awards" class="section" aria-labelledby="awards-heading">
  <div class="container">
    <h2 id="awards-heading" class="section-title display">수상 및 자격증</h2>

<div class="entry">
  <div class="entry-side">
    <h3>수상</h3>
  </div>
  <div class="entry-main">
    <ul>
      {
        profile.awards.map((a) => (
          <li>
            <span class="date">{a.date} </span>
            {a.title} · {a.org}{'team' in a && a.team && ` · 팀 ${a.team}`}
          </li>
        ))
      }
    </ul>
  </div>
</div>

<div class="entry">
  <div class="entry-side">
    <h3>자격증</h3>
  </div>
  <div class="entry-main">
    <ul>
      {
        profile.certifications.map((c) => (
          <li>
            <span class="date">{c.date} </span>
            {c.title}
            {'grade' in c && c.grade && ` ${c.grade}`} · {c.org}
          </li>
        ))
      }
    </ul>
  </div>
</div>

  </div>
</section>

<style>
  .date {
    color: var(--c-muted);
    font-variant-numeric: tabular-nums;
  }
</style>
